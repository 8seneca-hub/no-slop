{
 "version": 1,
 "rules": [
  {"id":"NS-K-01.01","tier":"Q","lang":"en","kind":"regex","pattern":"\\b(?:initiali[sz]e|increment|decrement|define|declare|create|set) (?:the |a |an )?(?:variable|counter|array|object|list|constant)\\b","flags":"i","message":"Comment restates the next line of code.","fix":"Delete it, or say why.","scope":["code-comment"]},
  {"id":"NS-K-02.01","tier":"Q","lang":"en","kind":"regex","pattern":"\\bstep\\s*\\d+\\s*[:.)-]","flags":"i","message":"Numbered step narration; the flow is visible in the code.","fix":"Delete it.","scope":["code-comment"]},
  {"id":"NS-K-03.01","tier":"P","lang":"en","kind":"regex","pattern":"\\b(?:added|adds|updated|changed|modified|new|removed|fixed) (?:a |an |the |new )?(?:function|method|class|helper|code|logic|check|handler|import)\\b(?: to\\b)?","flags":"i","message":"Comment announces the edit; history belongs in version control.","fix":"Delete it, or explain why the code exists.","scope":["code-comment"]},
  {"id":"NS-K-04.01","tier":"Q","lang":"en","kind":"phrase","pattern":"generated by","flags":"i","message":"Boilerplate header comment.","fix":"Delete it unless a tool requires the marker.","scope":["code-comment"]},
  {"id":"NS-K-04.02","tier":"Q","lang":"en","kind":"phrase","pattern":"this file contains","flags":"i","message":"Boilerplate header comment.","fix":"Delete it; the file name and exports say it.","scope":["code-comment"]},
  {"id":"NS-K-05.01","tier":"Q","lang":"any","kind":"regex","pattern":"[-=*#_~]{6,}","flags":"","message":"Decorative divider or banner comment.","fix":"Delete it.","scope":["code-comment"]},
  {"id":"NS-K-06.01","tier":"P","lang":"en","kind":"regex","pattern":"\\b(?:TODO|FIXME)\\b(?!\\s*\\()","flags":"","message":"TODO with no owner or task.","fix":"Add an owner and a ticket, as in TODO(name, #123), or delete it.","scope":["code-comment"]},
  {"id":"NS-K-09.01","tier":"Q","lang":"en","kind":"regex","pattern":"^\\s*(?:main|core|business) logic\\s*\\.?\\s*$|^\\s*helper (?:function|method)\\s*\\.?\\s*$","flags":"im","message":"Empty label comment.","fix":"Delete it.","scope":["code-comment"]}
 ]
}
